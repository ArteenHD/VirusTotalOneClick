<local:AppWindow
    x:Class="VirusTotalOneClick.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:VirusTotalOneClick.UI"
    Width="920"
    Height="830"
    MinWidth="760"
    MinHeight="480"
    ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="VirusTotal OneClick" ShowMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/VirusTotalOneClick;component/Assets/app-icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource PagePadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PageIconWellStyle}">
                        <ui:SymbolIcon Style="{StaticResource PageIconStyle}" Symbol="Settings24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource WindowTitleTextStyle}" Text="Settings" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Margin="{StaticResource LabelSpacing}"
                            Text="Uploads, folders, privacy, history, and Explorer integration." />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                    <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="Key24" />
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Account" />
                </StackPanel>
                <ui:Card Margin="{StaticResource ControlSpacing}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ui:PasswordBox
                                x:Name="ApiKeyPasswordBox"
                                PlaceholderText="Paste your VirusTotal API key"
                                PasswordChanged="ApiKeyPasswordBox_PasswordChanged" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Margin="{StaticResource LabelSpacing}"
                                Text="{Binding ApiKeyStatusText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Top">
                            <ui:Button Content="Save key" Command="{Binding SaveApiKeyCommand}" />
                            <ui:Button Content="Clear" Margin="8,0,0,0" Command="{Binding ClearApiKeyCommand}" />
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                        <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="CloudArrowUp24" />
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Uploads" />
                    </StackPanel>
                    <ui:Card Grid.Row="1" Grid.Column="0" Margin="{StaticResource ControlSpacing}" VerticalAlignment="Stretch">
                        <StackPanel>
                            <RadioButton
                                GroupName="UploadBehavior"
                                Content="Upload files immediately"
                                IsChecked="{Binding UploadImmediately}" />
                            <RadioButton
                                GroupName="UploadBehavior"
                                Margin="{StaticResource ControlSpacing}"
                                Content="Ask for confirmation before each upload"
                                IsChecked="{Binding ConfirmBeforeFileUpload}" />
                        </StackPanel>
                    </ui:Card>

                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                        <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="Folder24" />
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Folders" />
                    </StackPanel>
                    <ui:Card Grid.Row="1" Grid.Column="2" Margin="{StaticResource ControlSpacing}" VerticalAlignment="Stretch">
                        <StackPanel>
                            <RadioButton
                                GroupName="FolderHandling"
                                Content="Review folder contents and upload the selected files"
                                IsChecked="{Binding ReviewSelectedFiles}" />
                            <RadioButton
                                GroupName="FolderHandling"
                                Margin="{StaticResource ControlSpacing}"
                                Content="Review, then upload everything as one zip archive"
                                IsChecked="{Binding ReviewThenZip}" />
                        </StackPanel>
                    </ui:Card>

                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                        <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="EyeOff24" />
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Anonymizer" />
                    </StackPanel>
                    <ui:Card Grid.Row="3" Grid.Column="0" Margin="{StaticResource ControlSpacing}" VerticalAlignment="Stretch">
                        <StackPanel>
                            <CheckBox Content="Replace submitted file names with anonymous names" IsChecked="{Binding ScrubSubmittedFilename}" />
                            <CheckBox
                                Margin="{StaticResource ControlSpacing}"
                                Content="Hide folder structure inside uploaded zip archives"
                                IsChecked="{Binding ScrubZipInternalPaths}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Margin="{StaticResource ControlSpacing}"
                                Text="These options reduce what is sent as names or archive paths. They do not make public VirusTotal uploads private." />
                        </StackPanel>
                    </ui:Card>

                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                        <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="History24" />
                        <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="History" />
                    </StackPanel>
                    <ui:Card Grid.Row="3" Grid.Column="2" Margin="{StaticResource ControlSpacing}" VerticalAlignment="Stretch">
                        <StackPanel>
                            <CheckBox Content="Keep a local history of uploads on this computer" IsChecked="{Binding KeepLocalHistory}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Margin="{StaticResource LabelSpacing}"
                                Text="{Binding HistoryStatusText}" />
                            <StackPanel Orientation="Horizontal" Margin="{StaticResource ControlSpacing}">
                                <ui:Button Content="Open history" Icon="{ui:SymbolIcon Open24}" Command="{Binding OpenHistoryCommand}" />
                                <ui:Button Content="Clear history" Icon="{ui:SymbolIcon Delete24}" Margin="8,0,0,0" Command="{Binding ClearHistoryCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                    <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="PuzzlePiece24" />
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Integration" />
                </StackPanel>
                <ui:Card Margin="{StaticResource ControlSpacing}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0" Grid.Column="0" Content="Right-click menu" IsChecked="{Binding EnableClassicContextMenu}" />
                        <CheckBox Grid.Row="0" Grid.Column="2" Content="Send To menu" IsChecked="{Binding EnableSendToShortcut}" />
                        <CheckBox Grid.Row="1" Grid.Column="0" Margin="{StaticResource ControlSpacing}" Content="Start Menu shortcuts" IsChecked="{Binding EnableStartMenuShortcuts}" />
                        <CheckBox Grid.Row="1" Grid.Column="2" Margin="{StaticResource ControlSpacing}" Content="Open settings when Windows starts" IsChecked="{Binding LaunchOnStartup}" />
                    </Grid>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource CaptionTextStyle}"
                    VerticalAlignment="Center"
                    Text="{Binding SettingsStatusText}" />
                <ui:Button
                    x:Name="SaveSettingsButton"
                    Grid.Column="1"
                    Appearance="Primary"
                    IsDefault="True"
                    Content="Save settings"
                    Command="{Binding SaveSettingsCommand}" />
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="3"
            Margin="24,4,24,8"
            HorizontalAlignment="Center"
            Style="{StaticResource CaptionTextStyle}"
            Text="{Binding VersionCaption}" />
    </Grid>
</local:AppWindow>
