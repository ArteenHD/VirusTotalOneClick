<local:AppWindow
    x:Class="VirusTotalOneClick.UI.FolderReviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:VirusTotalOneClick.UI"
    Width="960"
    Height="680"
    MinWidth="720"
    MinHeight="560">
    <local:AppWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </local:AppWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="VirusTotal OneClick" />

        <StackPanel Grid.Row="1" Margin="24,12,24,0">
            <TextBlock Style="{StaticResource WindowTitleTextStyle}" Text="Review folder contents" />
            <TextBlock
                Style="{StaticResource CaptionTextStyle}"
                Margin="{StaticResource LabelSpacing}"
                Text="{Binding RootPath}" />
            <ui:Card Margin="{StaticResource ControlSpacing}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info24" VerticalAlignment="Top" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Margin="8,0,0,0"
                        MaxWidth="820"
                        Text="{Binding WarningText}" />
                </StackPanel>
            </ui:Card>
            <ui:Card
                Margin="{StaticResource ControlSpacing}"
                Visibility="{Binding HasTruncationWarning, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Symbol="Warning24"
                        VerticalAlignment="Top"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Margin="8,0,0,0"
                        MaxWidth="820"
                        Text="{Binding TruncationWarningText}" />
                </StackPanel>
            </ui:Card>
            <ui:Card
                Margin="{StaticResource ControlSpacing}"
                Visibility="{Binding HasScanErrors, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon
                        Symbol="Warning24"
                        VerticalAlignment="Top"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Margin="8,0,0,0"
                        MaxWidth="820"
                        Text="{Binding ScanErrorText}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,8">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
                <TextBlock
                    Style="{StaticResource BodyTextStyle}"
                    Margin="{StaticResource ControlSpacing}"
                    HorizontalAlignment="Center"
                    Text="{Binding LoadingStatusText}" />
            </StackPanel>
            <TreeView ItemsSource="{Binding RootNodes}">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsThreeState="False" IsChecked="{Binding IsChecked}" />
                            <TextBlock
                                Style="{StaticResource BodyTextStyle}"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Name}" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding DisplayDetail}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <Border
            Grid.Row="3"
            Padding="24,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="{Binding SelectionSummary}" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Margin="{StaticResource LabelSpacing}"
                        Text="{Binding ActionStatusText}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button
                        x:Name="UploadButton"
                        x:FieldModifier="internal"
                        Command="{Binding UploadSelectedFilesCommand}">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Secondary" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsUploadPrimary}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <TextBlock Text="Upload selected files" />
                    </ui:Button>
                    <ui:Button
                        x:Name="ZipButton"
                        x:FieldModifier="internal"
                        Margin="8,0,0,0"
                        Command="{Binding ZipSelectedItemsCommand}">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                                <Setter Property="Appearance" Value="Secondary" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsZipPrimary}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <TextBlock Text="Zip selected items and upload" />
                    </ui:Button>
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="Cancel"
                        IsCancel="True"
                        Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</local:AppWindow>
