<local:AppWindow
    x:Class="VirusTotalOneClick.UI.SetupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:VirusTotalOneClick.UI"
    Width="720"
    Height="780"
    ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="VirusTotal OneClick" ShowMaximize="False" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource PagePadding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource PageIconWellStyle}">
                        <ui:SymbolIcon Style="{StaticResource PageIconStyle}" Symbol="CloudArrowUp24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource WindowTitleTextStyle}" Text="Set up VirusTotal OneClick" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Margin="{StaticResource LabelSpacing}"
                            Text="Files upload to VirusTotal when you use the Explorer action. Folder selections open for review first." />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                    <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="Key24" />
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="API Key" />
                </StackPanel>
                <ui:Card Margin="{StaticResource ControlSpacing}">
                    <StackPanel>
                        <ui:PasswordBox
                            x:Name="ApiKeyPasswordBox"
                            PlaceholderText="Paste your VirusTotal API key"
                            PasswordChanged="ApiKeyPasswordBox_PasswordChanged" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Margin="{StaticResource LabelSpacing}"
                            Text="{Binding ApiKeyStatusText}" />
                    </StackPanel>
                </ui:Card>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                    <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="CloudArrowUp24" />
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Upload Behavior" />
                </StackPanel>
                <ui:Card Margin="{StaticResource ControlSpacing}">
                    <StackPanel>
                        <RadioButton
                            GroupName="UploadBehavior"
                            Content="Upload files immediately"
                            IsChecked="{Binding UploadImmediately}" />
                        <RadioButton
                            GroupName="UploadBehavior"
                            Margin="{StaticResource ControlSpacing}"
                            Content="Ask for confirmation before each upload"
                            IsChecked="{Binding ConfirmBeforeFileUpload}" />
                    </StackPanel>
                </ui:Card>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                    <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="Folder24" />
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Folders" />
                </StackPanel>
                <ui:Card Margin="{StaticResource ControlSpacing}">
                    <StackPanel>
                        <RadioButton
                            GroupName="FolderHandling"
                            Content="Review folder contents and upload the selected files"
                            IsChecked="{Binding ReviewSelectedFiles}" />
                        <RadioButton
                            GroupName="FolderHandling"
                            Margin="{StaticResource ControlSpacing}"
                            Content="Review, then upload everything as one zip archive"
                            IsChecked="{Binding ReviewThenZip}" />
                    </StackPanel>
                </ui:Card>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                    <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="History24" />
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="History" />
                </StackPanel>
                <ui:Card Margin="{StaticResource ControlSpacing}">
                    <CheckBox Content="Keep a local history of uploads on this computer" IsChecked="{Binding KeepLocalHistory}" />
                </ui:Card>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                    <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="EyeOff24" />
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Anonymizer" />
                </StackPanel>
                <ui:Card Margin="{StaticResource ControlSpacing}">
                    <StackPanel>
                        <CheckBox Content="Replace submitted file names with anonymous names" IsChecked="{Binding ScrubSubmittedFilename}" />
                        <CheckBox
                            Margin="{StaticResource ControlSpacing}"
                            Content="Hide folder structure inside uploaded zip archives"
                            IsChecked="{Binding ScrubZipInternalPaths}" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Margin="{StaticResource ControlSpacing}"
                            Text="These options reduce what is sent as names or archive paths. They do not make public VirusTotal uploads private." />
                    </StackPanel>
                </ui:Card>

                <StackPanel Orientation="Horizontal" Margin="{StaticResource SectionSpacing}">
                    <ui:SymbolIcon Style="{StaticResource SectionIconStyle}" Symbol="PuzzlePiece24" />
                    <TextBlock Style="{StaticResource SectionHeaderTextStyle}" Text="Explorer Integration" />
                </StackPanel>
                <ui:Card Margin="{StaticResource ControlSpacing}">
                    <StackPanel>
                        <CheckBox Content="Add to the right-click menu for files and folders" IsChecked="{Binding EnableClassicContextMenu}" />
                        <CheckBox
                            Margin="{StaticResource ControlSpacing}"
                            Content="Add to the Send To menu"
                            IsChecked="{Binding EnableSendToShortcut}" />
                        <CheckBox
                            Margin="{StaticResource ControlSpacing}"
                            Content="Add Start Menu shortcuts"
                            IsChecked="{Binding EnableStartMenuShortcuts}" />
                        <CheckBox
                            Margin="{StaticResource ControlSpacing}"
                            Content="Open settings when Windows starts"
                            IsChecked="{Binding LaunchOnStartup}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </ScrollViewer>

        <Border
            Grid.Row="2"
            Padding="24,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource CaptionTextStyle}"
                    VerticalAlignment="Center"
                    Text="{Binding SetupStatusText}" />
                <ui:Button
                    Grid.Column="1"
                    Appearance="Primary"
                    Click="SaveOrCloseButton_Click">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Save setup" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSetupSaved}" Value="True">
                                    <Setter Property="Content" Value="Close" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </Grid>
        </Border>
    </Grid>
</local:AppWindow>
