<local:AppWindow
    x:Class="VirusTotalOneClick.UI.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:VirusTotalOneClick.UI"
    Width="1000"
    Height="620"
    MinWidth="860"
    MinHeight="480">
    <local:AppWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </local:AppWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="VirusTotal OneClick" />

        <Grid Grid.Row="1" Margin="24,12,24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource WindowTitleTextStyle}" Text="Upload history" />
                <TextBlock
                    Style="{StaticResource CaptionTextStyle}"
                    Margin="{StaticResource LabelSpacing}"
                    Text="{Binding CaptionText}" />
            </StackPanel>
            <ui:TextBox
                Grid.Column="1"
                Width="260"
                VerticalAlignment="Center"
                PlaceholderText="Search history"
                Icon="{ui:SymbolIcon Search24}"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Grid Grid.Row="2" Margin="24,0,24,0">
            <ListView
                ItemsSource="{Binding VisibleRows}"
                SelectedItem="{Binding SelectedRow}"
                SelectionMode="Single">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Date" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateDisplay}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Original file" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding OriginalPath}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding OriginalPath}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Submitted name" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SubmittedName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="SHA-256" Width="140">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Sha256Display}" ToolTip="{Binding Sha256}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Mode" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Mode}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Status" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StatusLabel}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Result" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Text="{Binding ResultUrl}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding ResultUrl}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon Symbol="History24" FontSize="32" HorizontalAlignment="Center" />
                <TextBlock
                    Style="{StaticResource BodyTextStyle}"
                    Margin="{StaticResource ControlSpacing}"
                    HorizontalAlignment="Center"
                    Text="No uploads yet." />
                <TextBlock
                    Style="{StaticResource CaptionTextStyle}"
                    Margin="{StaticResource LabelSpacing}"
                    HorizontalAlignment="Center"
                    Text="Files uploaded through the Explorer action will appear here." />
            </StackPanel>
        </Grid>

        <Border
            Grid.Row="3"
            Padding="24,12"
            Margin="0,12,0,0"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Open result" Command="{Binding OpenResultCommand}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Content="Clear history"
                    Command="{Binding ClearHistoryCommand}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Content="Close"
                    IsCancel="True"
                    Click="OnCloseClick" />
            </StackPanel>
        </Border>
    </Grid>
</local:AppWindow>
