<local:AppWindow
    x:Class="VirusTotalOneClick.UI.UploadProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:VirusTotalOneClick.UI"
    Width="{x:Static local:AppWindow.TaskWindowWidth}"
    Height="{x:Static local:AppWindow.TaskWindowHeight}"
    MinWidth="{x:Static local:AppWindow.TaskWindowMinWidth}"
    MinHeight="{x:Static local:AppWindow.TaskWindowMinHeight}">
    <local:AppWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="QueueStatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Uploaded">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Uploading">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Needs API key">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QueueStatusIconStyle" TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="Symbol" Value="Clock24" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Uploaded">
                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Uploading">
                    <Setter Property="Symbol" Value="ArrowUpload24" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Canceled">
                    <Setter Property="Symbol" Value="DismissCircle24" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter Property="Symbol" Value="ErrorCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Needs API key">
                    <Setter Property="Symbol" Value="ErrorCircle24" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </local:AppWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="VirusTotal OneClick">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/VirusTotalOneClick;component/Assets/app-icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <StackPanel Grid.Row="1" Margin="24,12,24,0" Orientation="Horizontal">
            <Border Style="{StaticResource PageIconWellStyle}">
                <ui:SymbolIcon Style="{StaticResource PageIconStyle}" Symbol="CloudArrowUp24" />
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource WindowTitleTextStyle}" Text="Upload queue" />
                <TextBlock
                    Style="{StaticResource CaptionTextStyle}"
                    Margin="{StaticResource LabelSpacing}"
                    Text="{Binding StatusText}" />
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" Margin="24,12,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="{Binding ProgressSummary}" />
                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource CaptionTextStyle}"
                    FontWeight="SemiBold"
                    Text="{Binding ProgressPercent}" />
            </Grid>
            <ProgressBar
                Grid.Row="1"
                Height="4"
                Minimum="0"
                Maximum="{Binding TotalCount, Mode=OneWay}"
                Value="{Binding UploadedCount, Mode=OneWay}"
                IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="3" Margin="24,0,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Style="{StaticResource ListContainerStyle}">
            <ListView
                Background="Transparent"
                BorderThickness="0"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                ItemsSource="{Binding Items}"
                SelectionMode="Single"
                local:GridViewColumnFill.Enabled="True">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="44">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <ui:SymbolIcon Style="{StaticResource QueueStatusIconStyle}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Original file" Width="280" local:GridViewColumnFill.Weight="3">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding OriginalPath}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding OriginalPath}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Submitted name" Width="160">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SubmittedName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Status" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Style="{StaticResource QueueStatusTextStyle}"
                                        Text="{Binding DisplayStatus}"
                                        ToolTip="{Binding DisplayStatus}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Result" Width="180" local:GridViewColumnFill.Weight="2">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding ResultUrl}">
                                        <TextBlock.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem
                                                    Header="Copy link"
                                                    Icon="{ui:SymbolIcon Copy24}"
                                                    Click="OnCopyResultLinkClick" />
                                            </ContextMenu>
                                        </TextBlock.ContextMenu>
                                        <Hyperlink Click="OnResultLinkClick">
                                            <Run Text="{Binding ResultUrl, Mode=OneWay}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            </Border>
            <ui:Card Grid.Row="1" Margin="{StaticResource ControlSpacing}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Info24" VerticalAlignment="Center" />
                    <TextBlock
                        Style="{StaticResource CaptionTextStyle}"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Text="Files upload one at a time using VirusTotal API v3." />
                </StackPanel>
            </ui:Card>
        </Grid>

        <Border
            Grid.Row="4"
            Padding="24,12"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button
                    Content="Open settings"
                    Icon="{ui:SymbolIcon Settings24}"
                    Appearance="Secondary"
                    Visibility="{Binding ShowOpenSettings, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding OpenSettingsCommand}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Content="Upload"
                    Icon="{ui:SymbolIcon ArrowUpload24}"
                    Appearance="Primary"
                    Visibility="{Binding ShowUploadButton, Converter={StaticResource BoolToVisibility}}"
                    Command="{Binding UploadCommand}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Content="Open result"
                    Icon="{ui:SymbolIcon Open24}"
                    Command="{Binding OpenResultCommand}">
                    <ui:Button.Style>
                        <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Secondary" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOpenResultPrimary}" Value="True">
                                    <Setter Property="Appearance" Value="Primary" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
                <ui:Button
                    Margin="8,0,0,0"
                    Content="{Binding CancelButtonText}"
                    IsCancel="True"
                    Command="{Binding CancelCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</local:AppWindow>
