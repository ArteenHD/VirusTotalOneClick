<Application
    x:Class="VirusTotalOneClick.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="pack://application:,,,/VirusTotalOneClick;component/Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Plain WPF ListView/GridView chrome (used by the history and upload
                queue windows) isn't restyled by WPF-UI's ControlsDictionary, so it
                renders with classic system colors instead of the app theme.
            -->
            <Style TargetType="{x:Type GridViewColumnHeader}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="8,0,8,8" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            </Style>
            <Style TargetType="{x:Type ListViewItem}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <!--
                WPF-UI's CheckBox carries an 11px left inset that its RadioButton
                does not, so mixed cards get two left rails. Zero it so every
                toggle glyph sits on the card content edge.
            -->
            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Padding" Value="0,5,11,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
