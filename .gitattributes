* text=auto

# Source, docs, and config are LF
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# Git hooks run through sh and must stay LF
scripts/hooks/* text eol=lf

# Windows-native scripts are CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.iss text eol=crlf

# Binary assets
*.png binary
*.ico binary
*.gif binary
*.lnk binary
